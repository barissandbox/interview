{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview",
  "version": "1.1.1",
  "identifier": "com.barissandbox.interview",
  "build": {
    "beforeDevCommand": "npm run watch",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Interview",
        "width": 520,
        "height": 620,
        "minWidth": 430,
        "minHeight": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
